# Copy to .env and fill in:   cp .env.example .env
# NEVER commit .env or paste these values anywhere (chat, issues, screenshots).

# --- Upstox developer app (https://account.upstox.com/developer/apps) ---
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Must match EXACTLY the Redirect URL registered in the Upstox app.
UPSTOX_REDIRECT_URI=http://localhost:5000/upstox_redirect

# --- Signal engine (signal-only; the bot never places orders) ---
# Your broker's FULL round-trip cost per lot in rupees (brokerage + STT + exchange + GST + stamp). 40 is a placeholder.
TBRAIN_COST_PER_LOT=40
# Max rupees you are willing to lose on one call. 0 = not set (UI then shows risk per lot only).
TBRAIN_RISK_PER_TRADE=0
# Confluence threshold: how many of the 7 conditions must agree (5 = default, 6-7 = stricter, fewer calls).
TBRAIN_SIGNAL_MIN_SCORE=5

# --- Recorder tuning (defaults shown) ---
# TBRAIN_N_STRIKES=10          # strikes each side of ATM to record
# TBRAIN_N_EXPIRIES=2          # nearest N expiries to record
# TBRAIN_CHAIN_POLL_S=60       # REST option-chain snapshot interval (adds prev_oi / PCR)
# TBRAIN_FLUSH_S=30            # parquet flush interval
# TBRAIN_STALE_S=30            # force-reconnect if no feed message for this long (market hours)
# TBRAIN_UNDERLYINGS=NIFTY:NSE_FO,SENSEX:BSE_FO
# TBRAIN_RISK_FREE=0.065       # Black-76 discount rate (placeholder; tiny effect on short-dated IV)
# TBRAIN_TLS_VERIFY=1          # keep 1
